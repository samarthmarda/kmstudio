generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BodyType {
  female
  male
  child
}

enum PipelineStage {
  INQUIRY
  MEASURED
  ORDERED
  IN_PRODUCTION
  FITTING
  READY
  DELIVERED
}

enum MeasurementUnit {
  cm
  inches
}

enum PhotoTag {
  front
  back
  side
  fabric
  detail
  general
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  PAID
  CANCELLED
}

enum SupplierCategory {
  FABRIC
  TRIMS
  PACKAGING
  MACHINERY
  SERVICES
}

enum InventoryCategory {
  RAW_MATERIAL
  FABRIC
  TRIMS
  FINISHED_GOODS
  SERVICE
}

enum InventoryUnit {
  meters
  yards
  pieces
  rolls
  kg
  sets
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
}

enum ActivityCategory {
  client
  measurement
  order
  finance
  inventory
  production
}

model Client {
  id                  String               @id @default(cuid())
  name                String
  phone               String
  email               String
  bodyType            BodyType
  pipelineStage       PipelineStage        @default(INQUIRY)
  age                 Int?
  address             String?
  gstin               String?
  notes               String               @default("")
  customValues        Json?
  tags                String[]             @default([])
  totalSpend          Decimal              @default(0) @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  measurementSessions MeasurementSession[]
  photos              ClientPhoto[]
  salesOrders         SalesOrder[]
  invoices            Invoice[]
  activityLogs        ActivityLog[]

  @@index([name])
  @@index([pipelineStage])
  @@map("clients")
}

model MeasurementSession {
  id           String          @id @default(cuid())
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version      Int             @default(1)
  bodyType     BodyType
  unit         MeasurementUnit @default(cm)
  measurements Json
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  salesOrders  SalesOrder[]

  @@unique([clientId, version])
  @@index([clientId])
  @@map("measurement_sessions")
}

model ClientPhoto {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url       String
  title     String
  tag       PhotoTag @default(general)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("client_photos")
}

model Supplier {
  id             String           @id @default(cuid())
  name           String
  contactPerson  String           @default("")
  phone          String           @default("")
  email          String           @default("")
  gstin          String           @default("")
  address        String           @default("")
  category       SupplierCategory @default(FABRIC)
  balanceDue     Decimal          @default(0) @db.Decimal(12, 2)
  rating         Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

model InventoryItem {
  id            String            @id @default(cuid())
  sku           String            @unique
  name          String
  category      InventoryCategory
  unit          InventoryUnit
  currentStock  Decimal           @default(0) @db.Decimal(12, 3)
  minStockLevel Decimal           @default(0) @db.Decimal(12, 3)
  purchasePrice Decimal           @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal           @default(0) @db.Decimal(12, 2)
  hsnCode       String            @default("")
  gstRate       Decimal           @default(0) @db.Decimal(5, 2)
  location      String            @default("")
  imageUrl      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  purchaseItems PurchaseItem[]
  orderItems    SalesOrderItem[]
  invoiceItems  InvoiceItem[]

  @@index([category])
  @@index([name])
  @@map("inventory_items")
}

model SalesOrder {
  id             String              @id @default(cuid())
  orderNumber    String              @unique
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessionId      String?
  session        MeasurementSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  items          SalesOrderItem[]
  subtotal       Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal             @default(0) @db.Decimal(12, 2)
  status         OrderStatus         @default(DRAFT)
  orderDate      DateTime            @default(now())
  dueDate        DateTime
  deliveryDate   DateTime?
  notes          String?
  assignedTailor String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  invoices       Invoice[]

  @@index([clientId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name        String
  description String?
  quantity    Int            @default(1)
  unitPrice   Decimal        @default(0) @db.Decimal(12, 2)
  gstRate     Decimal        @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal        @default(0) @db.Decimal(12, 2)

  @@index([orderId])
  @@index([itemId])
  @@map("sales_order_items")
}

model Invoice {
  id            String           @id @default(cuid())
  invoiceNumber String           @unique
  orderId       String?
  order         SalesOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientGstin   String?
  items         InvoiceItem[]
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal          @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus    @default(DRAFT)
  issueDate     DateTime         @default(now())
  dueDate       DateTime
  payments      InvoicePayment[]
  notes         String?
  irn           String?
  qrCodeMock    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String         @id @default(cuid())
  invoiceId   String
  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name        String
  description String?
  quantity    Int            @default(1)
  unitPrice   Decimal        @default(0) @db.Decimal(12, 2)
  gstRate     Decimal        @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal        @default(0) @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_items")
}

model InvoicePayment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  paidAt          DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@map("invoice_payments")
}

model PurchaseOrder {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @default(0) @db.Decimal(12, 2)
  status         PurchaseStatus @default(DRAFT)
  orderDate      DateTime       @default(now())
  expectedDate   DateTime
  receivedDate   DateTime?
  paidAmount     Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String?
  item            InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName        String
  quantity        Decimal        @default(0) @db.Decimal(12, 3)
  unit            InventoryUnit  @default(pieces)
  unitPrice       Decimal        @default(0) @db.Decimal(12, 2)
  gstRate         Decimal        @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal        @default(0) @db.Decimal(12, 2)

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_items")
}

model ActivityLog {
  id          String           @id @default(cuid())
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  action      String
  title       String
  description String           @default("")
  user        String
  category    ActivityCategory @default(client)
  timestamp   DateTime         @default(now())

  @@index([clientId])
  @@index([category])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Universal BOSS core. All new entities use UUID primary keys and are scoped
// to a company (the tenant boundary). The tailoring models above are kept as
// a separate business vertical.
// ---------------------------------------------------------------------------

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PartyRole {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  LENDER
  PARTNER
  GOVERNMENT
  SERVICE_PROVIDER
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum LedgerAccountType {
  CURRENT_ASSET
  FIXED_ASSET
  BANK
  CASH
  ACCOUNTS_RECEIVABLE
  CURRENT_LIABILITY
  ACCOUNTS_PAYABLE
  EQUITY
  DIRECT_INCOME
  INDIRECT_INCOME
  DIRECT_EXPENSE
  INDIRECT_EXPENSE
  TAX_PAYABLE
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum ProductType {
  GOODS
  SERVICE
}

enum UnitOfMeasure {
  PIECE
  METER
  YARD
  KILOGRAM
  GRAM
  LITER
  SET
  ROLL
  BOX
  HOUR
}

enum StockMovementType {
  OPENING
  PURCHASE_IN
  SALES_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model Organisation {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  slug      String               @unique
  legalName String?
  email     String?
  phone     String?
  logoUrl   String?
  status    OrganisationStatus   @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganisationMember[]
  companies Company[]

  @@map("organisations")
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique
  name           String
  passwordHash   String?
  phone          String?
  avatarUrl      String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    OrganisationMember[]
  journalEntries JournalEntry[]       @relation("JournalEntryCreatedBy")
  stockMovements StockMovement[]      @relation("StockMovementCreatedBy")

  @@map("users")
}

model OrganisationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganisationRole @default(MEMBER)
  status         MemberStatus     @default(ACTIVE)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, role])
  @@map("organisation_members")
}

model Company {
  id                      String                   @id @default(uuid()) @db.Uuid
  organisationId          String                   @db.Uuid
  name                    String
  slug                    String
  legalName               String?
  gstin                   String?
  pan                     String?
  currency                String                   @default("INR")
  timezone                String                   @default("Asia/Kolkata")
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String                   @default("India")
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organisation            Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branches                Branch[]
  financialYears          FinancialYear[]
  accountingConfiguration AccountingConfiguration?
  parties                 Party[]
  ledgerAccounts          LedgerAccount[]
  journalEntries          JournalEntry[]
  products                Product[]
  stockMovements          StockMovement[]
  stockBalances           StockBalance[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@map("companies")
}

model Branch {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  name           String
  code           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String          @default("India")
  isPrimary      Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  stockMovements StockMovement[]
  stockBalances  StockBalance[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Party {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @db.Uuid
  code               String
  name               String
  legalName          String?
  email              String?
  phone              String?
  gstin              String?
  pan                String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String                @default("India")
  creditLimit        Decimal               @default(0) @db.Decimal(18, 2)
  creditDays         Int                   @default(0)
  openingBalance     Decimal               @default(0) @db.Decimal(18, 2)
  openingBalanceType BalanceType           @default(DEBIT)
  notes              String?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleAssignments    PartyRoleAssignment[]
  ledgerAccounts     LedgerAccount[]

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("parties")
}

model PartyRoleAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  partyId    String    @db.Uuid
  role       PartyRole
  isPrimary  Boolean   @default(false)
  assignedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  party      Party     @relation(fields: [partyId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([partyId, role])
  @@index([companyId, role])
  @@map("party_role_assignments")
}

model FinancialYear {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  name           String
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  isActive       Boolean        @default(false)
  isClosed       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("financial_years")
}

model AccountingConfiguration {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @unique @db.Uuid
  baseCurrency         String   @default("INR")
  fiscalYearStartMonth Int      @default(4)
  fiscalYearStartDay   Int      @default(1)
  dateFormat           String   @default("DD/MM/YYYY")
  timezone             String   @default("Asia/Kolkata")
  roundingPrecision    Int      @default(2)
  isLocked             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("accounting_configurations")
}

model LedgerAccount {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  code               String
  name               String
  category           AccountCategory
  type               LedgerAccountType
  parentId           String?           @db.Uuid
  partyId            String?           @db.Uuid
  isSystem           Boolean           @default(false)
  isActive           Boolean           @default(true)
  openingBalance     Decimal           @default(0) @db.Decimal(18, 2)
  openingBalanceType BalanceType       @default(DEBIT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent             LedgerAccount?    @relation("LedgerHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           LedgerAccount[]   @relation("LedgerHierarchy")
  party              Party?            @relation(fields: [partyId], references: [id], onDelete: SetNull)
  journalLines       JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, category])
  @@index([parentId])
  @@index([partyId])
  @@map("ledger_accounts")
}

model JournalEntry {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @db.Uuid
  financialYearId String             @db.Uuid
  branchId        String?            @db.Uuid
  entryNumber     String
  entryDate       DateTime           @db.Date
  narration       String             @default("")
  referenceType   String?
  referenceId     String?
  status          JournalEntryStatus @default(DRAFT)
  postedAt        DateTime?
  createdById     String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear      @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  branch          Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines           JournalLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, entryDate])
  @@index([financialYearId])
  @@index([branchId])
  @@map("journal_entries")
}

model JournalLine {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  journalEntryId  String        @db.Uuid
  ledgerAccountId String        @db.Uuid
  lineNumber      Int
  description     String?
  debit           Decimal       @default(0) @db.Decimal(18, 2)
  credit          Decimal       @default(0) @db.Decimal(18, 2)
  createdAt       DateTime      @default(now())
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([companyId])
  @@index([ledgerAccountId])
  @@map("journal_lines")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  sku            String
  name           String
  description    String?
  type           ProductType     @default(GOODS)
  unit           UnitOfMeasure   @default(PIECE)
  hsnCode        String?
  gstRate        Decimal         @default(0) @db.Decimal(5, 2)
  purchasePrice  Decimal         @default(0) @db.Decimal(18, 2)
  sellingPrice   Decimal         @default(0) @db.Decimal(18, 2)
  trackInventory Boolean         @default(true)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  stockBalances  StockBalance[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  productId     String            @db.Uuid
  branchId      String?           @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(18, 3)
  unitCost      Decimal?          @db.Decimal(18, 4)
  referenceType String?
  referenceId   String?
  reason        String?
  occurredAt    DateTime          @default(now())
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, productId])
  @@index([companyId, occurredAt])
  @@index([branchId])
  @@map("stock_movements")
}

model StockBalance {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  productId        String   @db.Uuid
  branchId         String   @db.Uuid
  quantity         Decimal  @default(0) @db.Decimal(18, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(18, 3)
  averageCost      Decimal  @default(0) @db.Decimal(18, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([companyId, productId, branchId])
  @@index([companyId, branchId])
  @@map("stock_balances")
}
